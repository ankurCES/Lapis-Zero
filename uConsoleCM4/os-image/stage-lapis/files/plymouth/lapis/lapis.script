# Lapis-Deck boot splash (Plymouth script theme; art from os-image/make-splash.py).
# The art is upright landscape. The uConsole panel is 720x1280 portrait, so it is turned the
# way the HUD turns its frame (lapis-ui --rotate, default 90 = clockwise when portrait).
# Knob: if the HUD needs --rotate 270 on this unit, set TURN to -Math.Pi / 2 here too.
TURN = Math.Pi / 2;
if (Window.GetWidth() >= Window.GetHeight()) TURN = 0;

Window.SetBackgroundTopColor(0.027, 0.039, 0.055);  # theme::BG (7, 10, 14)
Window.SetBackgroundBottomColor(0.027, 0.039, 0.055);
cx = Window.GetX() + Window.GetWidth() / 2;
cy = Window.GetY() + Window.GetHeight() / 2;

# A sprite whose centre sits at art coordinates (u, v): pixels right/down of the screen centre
# as the viewer sees the upright art.
fun place(image, u, v, z) {
    local.img = image.Rotate(global.TURN);
    local.s = Sprite(local.img);
    local.s.SetX(global.cx + u * Math.Cos(global.TURN) - v * Math.Sin(global.TURN) - local.img.GetWidth() / 2);
    local.s.SetY(global.cy + u * Math.Sin(global.TURN) + v * Math.Cos(global.TURN) - local.img.GetHeight() / 2);
    local.s.SetZ(z);
    local.s.SetOpacity(0);
    return local.s;
}

glow = place(Image("glow.png"), 0, 0, 1);
logo = place(Image("logo.png"), 0, 0, 2);
dot = Image("dot.png");
for (i = 0; i < 7; i++) dots[i] = place(dot, (i - 3) * 26, 215, 3);

t = 0;
fun refresh() {
    # ~50 calls a second: fade in over 0.6 s, then the glow breathes and a light runs the dots.
    global.t++;
    local.a = Math.Min(global.t / 30, 1);
    global.logo.SetOpacity(local.a);
    global.glow.SetOpacity(local.a * (0.6 + 0.4 * Math.Sin(global.t / 22)));
    local.head = (global.t / 5) % 11 - 2;
    for (local.i = 0; local.i < 7; local.i++) {
        local.b = Math.Max(0, 1 - Math.Abs(local.head - local.i) / 1.6);
        global.dots[local.i].SetOpacity(local.a * (0.15 + 0.85 * local.b));
    }
}
Plymouth.SetRefreshFunction(refresh);
