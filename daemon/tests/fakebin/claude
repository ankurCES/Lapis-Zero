#!/bin/sh
# Stands in for an agent tool: records exactly what it was given (in $OUT, else the
# home folder) and answers like `claude -p --output-format json`, counting its runs.
out=${OUT:-$HOME}
cat > "$out/stdin"
: > "$out/args"
for a in "$@"; do printf '%s\0' "$a" >> "$out/args"; done
pwd > "$out/cwd"
echo "$TERM $NO_COLOR" > "$out/env"
n=$(cat "$out/n" 2>/dev/null || echo 0); n=$((n + 1)); echo $n > "$out/n"
printf '{"type":"result","is_error":false,"result":"answer %s","session_id":"sess-%s"}\n' $n $n
