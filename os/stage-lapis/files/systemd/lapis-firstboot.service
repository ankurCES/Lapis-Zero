[Unit]
Description=Lapis-Zero first-boot seed importer
After=local-fs.target
RequiresMountsFor=/boot/firmware
Before=NetworkManager.service lapis-daemon.service lapis-tailscale-up.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/lapis/lapis-firstboot.sh
TimeoutStartSec=60
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
