<?xml version="1.0" encoding="utf-8"?>
<!--
  Production traffic is HTTPS/WSS to the device's Tailscale name. Cleartext exists only for a
  development daemon reached through `adb reverse` (127.0.0.1 / localhost) or from the emulator
  (10.0.2.2); every other host is refused by the platform.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
