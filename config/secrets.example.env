# Lapis-Zero OS — Secrets Environment Template
#
# Runtime location:
#   /etc/lapis/secrets.env (MUST be owned by root/lapis with permissions chmod 600).
#   Loaded by lapis-daemon.service via systemd:
#     EnvironmentFile=-/etc/lapis/secrets.env
#
# First-boot seeding:
#   To provision headlessly before first boot, copy this file to the microSD
#   card's FAT32 boot partition as /boot/firmware/lapis-seed/secrets.env and
#   fill in your values. On first boot, lapis-firstboot.sh moves it to
#   /etc/lapis/secrets.env (chmod 600) and securely shreds/deletes the seed
#   file from /boot/firmware/ so plaintext secrets never remain on FAT32.
#
# WARNING:
#   NEVER commit real API keys, passwords, or auth keys to git!

# Anthropic API key (used when [llm].provider = "anthropic")
ANTHROPIC_API_KEY=

# OpenAI API key (used when [llm].provider = "openai" or for Whisper STT)
OPENAI_API_KEY=

# VNC password for the "macbook-pro" host defined in /etc/lapis/hosts.toml
# Add one LAPIS_VNC_PASSWORD_<host_key>= line per host (replace '-' with '_')
LAPIS_VNC_PASSWORD_macbook_pro=

# Optional Tailscale pre-auth key for headless first-boot tailnet join
LAPIS_TS_AUTHKEY=
